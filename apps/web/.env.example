# LLM layer of item resolution. Default: a local Ollama model.
# VITE_RESOLVER_PROVIDER=ollama          # or "anthropic" to use the worker in apps/resolver
# VITE_OLLAMA_URL=http://localhost:11434 # on a phone, the Mac's LAN address: http://192.168.1.20:11434 (put it in .env.local)
# VITE_OLLAMA_MODEL=qwen3:14b
# VITE_RESOLVER_URL=https://grosher-resolver.<account>.workers.dev   # anthropic provider only; dev proxies /api → wrangler dev :8787
