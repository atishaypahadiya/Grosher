# Cloudflare Pages headers (copied into dist/ by Vite).
#
# The PWA shell must always be revalidated so a new deploy reaches installed
# apps on the next open: the service worker, its registration script, the
# manifest and the HTML. Everything Vite emits under /assets/ is hashed and
# can be cached forever; so are the fonts and the Workbox runtime (hashed).

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store
  Access-Control-Allow-Origin: *

/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# the project write-up's media keep their names across captures: a day, then revalidate
/project/img/*
  Cache-Control: public, max-age=86400

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
